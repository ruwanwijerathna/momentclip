PORT=8787
DATA_DIR=./data

# Limits
MAX_SEGMENTS=10
MAX_SEGMENT_SECONDS=1800
CONCURRENCY=2
JOB_TTL_MINUTES=60
CLIP_TIMEOUT_MINUTES=20
RATE_LIMIT_PER_MIN=30

# yt-dlp
YTDLP_PATH=yt-dlp
# Netscape-format cookies file; helps when YouTube asks the server to "confirm you're not a bot"
YTDLP_COOKIES=
# Extra flags passed to every yt-dlp call, e.g. "--proxy socks5://user:pass@host:1080"
YTDLP_EXTRA_ARGS=

# Only needed if the SPA is hosted on a different origin than the API
CORS_ORIGIN=

# Convocation catalog (University → Convocation → Day → Session → Video)
CATALOG_FILE=./catalog/convocations.json
# true = only videos listed in the catalog can be loaded or exported
CATALOG_ONLY=false
