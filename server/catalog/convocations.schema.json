{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MomentClip convocation catalog",
  "description": "University → Convocation → Day → Session → YouTube video. Times may be seconds or \"h:mm:ss\" strings.",
  "type": "object",
  "required": ["universities"],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "time": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^\\d+(:\\d{1,2}){0,2}(\\.\\d+)?$" }
      ]
    },
    "session": {
      "type": "object",
      "required": ["id", "name", "video"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string" },
        "startsAt": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "description": "Local start time, 24h" },
        "faculties": { "type": "array", "items": { "type": "string" } },
        "degrees": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "video": {
          "type": "object",
          "required": ["youtubeId"],
          "properties": {
            "youtubeId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
            "duration": { "$ref": "#/$defs/time" },
            "title": { "type": "string" }
          }
        },
        "markers": {
          "type": "array",
          "description": "Jump points inside the video, e.g. where each faculty or degree starts",
          "items": {
            "type": "object",
            "required": ["t", "label"],
            "properties": {
              "t": { "$ref": "#/$defs/time" },
              "label": { "type": "string" },
              "kind": { "enum": ["ceremony", "speech", "faculty", "degree", "section"] }
            }
          }
        }
      }
    }
  },
  "properties": {
    "version": { "type": "integer" },
    "updatedAt": { "type": "string" },
    "universities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "convocations"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "name": { "type": "string" },
          "shortName": { "type": "string" },
          "location": { "type": "string" },
          "timezone": { "type": "string" },
          "website": { "type": "string" },
          "convocations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "days"],
              "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "title": { "type": "string" },
                "year": { "type": "integer" },
                "days": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["date", "sessions"],
                    "properties": {
                      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                      "label": { "type": "string" },
                      "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
